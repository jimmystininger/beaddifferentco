{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/categories.html", "destination": "/shop-all.html", "permanent": true },
    { "source": "/new-arrivals.html", "destination": "/category.html?category=new-arrivals", "permanent": true },
    { "source": "/acrylic-beads.html", "destination": "/category.html?category=acrylic", "permanent": true },
    { "source": "/silicone-beads.html", "destination": "/category.html?category=silicone", "permanent": true },
    { "source": "/focal-beads.html", "destination": "/category.html?category=focal-beads", "permanent": true },
    { "source": "/rhinestones.html", "destination": "/category.html?category=rhinestone-beads", "permanent": true },
    { "source": "/flatbacks.html", "destination": "/category.html?category=acrylic-flatbacks", "permanent": true },
    { "source": "/pen-supplies.html", "destination": "/category.html?category=beadable-pen-blanks", "permanent": true },
    { "source": "/mixes-kits.html", "destination": "/category.html?category=mixes-bundles-kits", "permanent": true },
    { "source": "/clearance.html", "destination": "/category.html?category=clearance-section", "permanent": true },
    { "source": "/pink-heart-focal-bead.html", "destination": "/product.html?id=pink-heart-focal-bead", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" }
  ],
  "headers": [
    { "source": "/account.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/search.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/shopping-bag.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/wishlist.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/payment-success.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/payment-cancelled.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://*.vercel-insights.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "/vendor/supabase.min.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400" }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
